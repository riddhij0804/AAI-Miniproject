# Environment Configuration for Autonomous Research Intelligence Subsystem
APP_NAME="Autonomous Research Intelligence & Evidence Subsystem"
ENVIRONMENT=development
DEBUG=false

# Database Configuration
DATABASE_URL=sqlite:///./research_intelligence.db
ECHO_SQL=false

# Vector Store (Qdrant)
QDRANT_LOCATION=./qdrant_data
# QDRANT_LOCATION=http://localhost:6333
QDRANT_COLLECTION=evidence_chunks

# Embeddings
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CHECKPOINT_DATABASE_PATH=./research_checkpoints.db

# Web Search Providers
TAVILY_API_KEY=
# Fallback to DuckDuckGo is automatic if Tavily is unset or fails

# LLM Providers (at least one key is required to run the autonomous workflow)
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_MAX_RPM=12
EXTRACTION_USE_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Browser access
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

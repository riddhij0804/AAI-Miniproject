# Environment Configuration for Autonomous Research Intelligence Subsystem
APP_NAME="Autonomous Research Intelligence & Evidence Subsystem"
ENVIRONMENT=development
DEBUG=false

# Database Configuration
DATABASE_URL=sqlite:///./research_intelligence.db
ECHO_SQL=false

# Vector Store (Qdrant)
QDRANT_LOCATION=:memory:
# QDRANT_LOCATION=./qdrant_data
# QDRANT_LOCATION=http://localhost:6333
QDRANT_COLLECTION=evidence_chunks

# Embeddings
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Web Search Providers
TAVILY_API_KEY=
# Fallback to DuckDuckGo is automatic if Tavily is unset or fails

# LLM Providers for Extraction (optional: uses heuristic deterministic extraction if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
